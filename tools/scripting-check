        rbw.stop()
        shutil.rmtree(home, ignore_errors=True)


def two_step(server, password):
    email = f"scripting-2fa-{secrets.token_hex(4)}@example.com"
    register(server, email, password)
    secret = enable_authenticator(server, email, password)
    home = tempfile.mkdtemp(prefix="rbw-scripting-")
    rbw = Rbw(home, server, email)
    quiet = {"RBW_NONINTERACTIVE": "1"}
    try:
        error = rbw.error("login", "--password-stdin", stdin=password)
        check("login asks for a two-step code",
              error["code"] == "two_step_required" and error["methods"] == [0]
              and "two-step login code required; methods: 0" in error["message"], str(error))
        error = rbw.error("login", "--password-stdin", "--method", "0", "--code", "000000",
                          stdin=password)
        check("a wrong code is refused",
              error["code"] == "incorrect_code" and "code is incorrect" in error["message"],
              str(error))
        rbw.fails("login", "--password-stdin", "--method", "2", "--code", "1",
                  stdin=password, env=quiet, needle="isn't supported")
        rbw.fails("login", "--password-stdin", "--method", "0", "--code-env",
                  stdin=password, env=quiet, needle="--code-env needs RBW_CODE")
        # the server refuses a code twice, and enabling used this one
        time.sleep(30 - time.time() % 30 + 1)
        rbw.run("login", "--password-stdin", "--method", "0", "--code-env",
                stdin=password, env={**quiet, "RBW_CODE": totp(secret)})
        check("login with the code in RBW_CODE",
              rbw.json("status", "--json")["status"] == "unlocked")
    finally:
        rbw.stop()
        shutil.rmtree(home, ignore_errors=True)


def registering(server, password):
    """Registering the device with the personal API key, then logging in."""
    email = f"scripting-key-{secrets.token_hex(4)}@example.com"
    register(server, email, password)
    client_id, client_secret = api_key(server, email, password)
    home = tempfile.mkdtemp(prefix="rbw-scripting-")
    rbw = Rbw(home, server, email)
    quiet = {"RBW_NONINTERACTIVE": "1"}
    try:
        error = rbw.error("register", "--api-key-env", env={
            "RBW_CLIENT_ID": client_id, "RBW_CLIENT_SECRET": "wrong"})
        check("register refuses a wrong API key",
              error["code"] == "incorrect_password", str(error))
        rbw.run("register", "--api-key-env", env={
            **quiet, "RBW_CLIENT_ID": client_id, "RBW_CLIENT_SECRET": client_secret})
        rbw.run("login", "--password-stdin", stdin=password, env=quiet)
        check("login after register", rbw.json("status", "--json")["status"] == "unlocked")
    finally:
        rbw.stop()
        shutil.rmtree(home, ignore_errors=True)


def wrong_server(server, password):
    """A server address that leads to no Bitwarden server."""
    home = tempfile.mkdtemp(prefix="rbw-scripting-")
    rbw = Rbw(home, server.rstrip("/") + "/nothing-here", "nobody@example.com")
    try:
        check("login names a wrong server address",
              rbw.error("login", "--password-stdin", stdin=password)["code"] == "wrong_server")
        error = rbw.error("register", "--api-key-env",
                          env={"RBW_CLIENT_ID": "user.x", "RBW_CLIENT_SECRET": "x"})
        check("and so does register", error["code"] == "wrong_server", str(error))
    finally:
        rbw.stop()
        shutil.rmtree(home, ignore_errors=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--server", required=True)
    parser.add_argument("--password", default="correct horse battery staple")
    args = parser.parse_args()
    try:
        scenario(args.server, args.password)
        two_step(args.server, args.password)
        registering(args.server, args.password)
        wrong_server(args.server, args.password)
    except AssertionError as e:
        print(f"FAIL {e}")
        sys.exit(1)
    print(f"{PASSED} checks passed")


if __name__ == "__main__":
    main()
