def kinds(rbw, quiet):
    """Cards, identities and SSH keys, saved and read back."""
    card = rbw.json("item", "create", env=quiet, stdin=json.dumps({
        "type": 3, "name": "Visa", "card": {
            "cardholderName": "Alex Martin", "brand": "Visa",
            "number": "4111111111111111", "expMonth": "09", "expYear": "2029",
            "code": "123"}}))
    check("create saves a card",
          card["type"] == 3 and card["card"] == {"brand": "Visa"}, str(card))
    full = rbw.json("item", "get", card["id"], env=quiet)
    check("get shows the card", full["card"]["number"] == "4111111111111111"
          and full["card"]["code"] == "123")
    full["card"]["code"] = "456"
    rbw.run("item", "edit", card["id"], env=quiet, stdin=json.dumps(full))
    check("edit changes a card",
          rbw.json("item", "get", card["id"], env=quiet)["card"]["code"] == "456")

    identity = rbw.json("item", "create", env=quiet, stdin=json.dumps({
        "type": 4, "name": "Me", "identity": {
            "firstName": "Alex", "lastName": "Martin", "city": "Lyon",
            "passportNumber": "19AB12345"}}))
    check("create saves an identity, listed by its names",
          identity["identity"]["firstName"] == "Alex"
          and "passportNumber" not in identity["identity"], str(identity))
    full = rbw.json("item", "get", identity["id"], env=quiet)
    check("get shows the identity", full["identity"]["passportNumber"] == "19AB12345"
          and full["identity"]["city"] == "Lyon")

    key = rbw.json("item", "create", env=quiet, stdin=json.dumps({
        "type": 5, "name": "Laptop", "sshKey": {"privateKey": SSH_PRIVATE_KEY}}))
    check("create saves an SSH key with its public key and fingerprint",
          key["sshKey"]["keyFingerprint"] == SSH_FINGERPRINT
          and key["sshKey"]["publicKey"].startswith("ssh-ed25519 ")
          and "privateKey" not in key["sshKey"], str(key))
    full = rbw.json("item", "get", key["id"], env=quiet)
    check("get shows the private key", full["sshKey"]["privateKey"] == SSH_PRIVATE_KEY)
    error = rbw.error("item", "create", stdin=json.dumps({
        "type": 5, "name": "Broken", "sshKey": {"privateKey": "not a key"}}))
    check("a broken SSH key is refused", error["code"] == "invalid_input", str(error))


def folders(rbw, quiet):
    """Folders, also empty ones, and entries in them."""
    folder = rbw.json("folder", "create", "Travel", env=quiet)
    check("folder create prints the folder",
          folder["object"] == "folder" and folder["name"] == "Travel" and folder["id"])
    check("folder list has the empty folder",
          folder in rbw.json("folder", "list", env=quiet))
    note = rbw.json("item", "create", env=quiet, stdin=json.dumps({
        "type": 2, "name": "Passport scan", "folderId": folder["id"]}))
    check("an entry goes into the folder", note["folderId"] == folder["id"])


def favorites(rbw, quiet):
    """The favorite flag, set by create and edit, kept when left out."""
    note = rbw.json("item", "create", env=quiet, stdin=json.dumps({
        "type": 2, "name": "Starred", "notes": "x", "favorite": True}))
    check("create marks a favorite", note["favorite"] is True)
    full = rbw.json("item", "get", note["id"], env=quiet)
    del full["favorite"]
    rbw.run("item", "edit", note["id"], env=quiet, stdin=json.dumps(full))
    check("edit without the flag keeps it",
          rbw.json("item", "get", note["id"], env=quiet)["favorite"] is True)
    full["favorite"] = False
    edited = rbw.json("item", "edit", note["id"], env=quiet, stdin=json.dumps(full))
    check("edit unmarks a favorite", edited["favorite"] is False)
    marked = rbw.json("item", "favorite", note["id"], "true", env=quiet)
    check("item favorite marks it without the secrets",
          marked["favorite"] is True
          and rbw.json("item", "get", note["id"], env=quiet)["notes"] == "x", str(marked))
    folder = rbw.json("folder", "create", "Starred things", env=quiet)
    moved = rbw.json("item", "move", note["id"], folder["id"], env=quiet)
    check("item move puts it in a folder and keeps the flag",
          moved["folderId"] == folder["id"] and moved["favorite"] is True, str(moved))
    moved = rbw.json("item", "move", note["id"], env=quiet)
    check("item move without a folder takes it out", moved["folderId"] is None, str(moved))
    check("item move to an unknown folder is not_found",
          rbw.error("item", "move", note["id"], "00000000-0000-0000-0000-000000000000")["code"]
          == "not_found")

    rbw.run("item", "delete", note["id"], env=quiet)
    check("delete moves an entry out of the list",
          all(item["id"] != note["id"] for item in rbw.json("item", "list", env=quiet)))
    check("a deleted entry is gone",
          rbw.error("item", "get", note["id"])["code"] == "not_found")


def other_device(rbw, quiet, server, email, password):
    """Changes that another device made since the last sync."""
    note = rbw.json("item", "create", env=quiet, stdin=json.dumps({
        "type": 2, "name": "Moved elsewhere", "notes": "x"}))
    folder = rbw.json("folder", "create", "Elsewhere", env=quiet)
    call, _ = api(server, email, password)
    call(f"/api/ciphers/{note['id']}/partial", {"folderId": folder["id"], "favorite": False})
    marked = rbw.json("item", "favorite", note["id"], "true", env=quiet)
    check("item favorite keeps the folder another device set",
          marked["folderId"] == folder["id"] and marked["favorite"] is True, str(marked))
    call(f"/api/ciphers/{note['id']}/partial", {"folderId": folder["id"], "favorite": False})
    moved = rbw.json("item", "move", note["id"], env=quiet)
    check("item move keeps the flag another device set",
          moved["folderId"] is None and moved["favorite"] is False, str(moved))


def share_login(server, email, password, public_der):
    """Creates an organization with two logins in its collection, as its
    owner, the second with master password reprompt; returns their ids."""
    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import padding

    call, _ = api(server, email, password)
    org_key = secrets.token_bytes(64)
    seal = lambda text: encrypt(org_key[:32], org_key[32:], text.encode())
    wrapped = serialization.load_der_public_key(public_der).encrypt(
        org_key, padding.OAEP(mgf=padding.MGF1(hashes.SHA1()),
                              algorithm=hashes.SHA1(), label=None))
    org_public, org_private = rsa_keys()
    org = call("/api/organizations", {
        "name": "Family", "billingEmail": email, "planType": 0,
        "collectionName": seal("Shared"), "key": f"4.{b64(wrapped)}",
        "keys": {"publicKey": b64(org_public),
                 "encryptedPrivateKey": encrypt(org_key[:32], org_key[32:], org_private)},
    })
    collections = call(f"/api/organizations/{org['id']}/collections")["data"]
    user_id = call("/api/accounts/profile")["id"]
    cipher = call("/api/ciphers/create", {
        "cipher": {"type": 1, "name": seal("Family router"), "organizationId": org["id"],
                   "encryptedFor": user_id,
                   "login": {"username": seal("admin"), "password": seal("router-password")}},
        "collectionIds": [collections[0]["id"]],
    })
    protected = call("/api/ciphers/create", {
        "cipher": {"type": 1, "name": seal("Bank"), "organizationId": org["id"],
                   "encryptedFor": user_id, "reprompt": 1,
                   "login": {"username": seal("me"), "password": seal("bank-password"),
                             "totp": seal("JBSWY3DPEHPK3PXP")}},
        "collectionIds": [collections[0]["id"]],
    })
    return cipher["id"], protected["id"]


def protected_kinds(server, email, password):
    """A card, an identity, a secure note and an SSH key that ask for the
    master password again, each with notes and a custom field; returns
    their ids by kind."""
    call, _ = api(server, email, password)
    user_key = decrypt(*stretched_key(email, password),
                       call("/api/accounts/profile")["key"])
    seal = lambda text: encrypt(user_key[:32], user_key[32:], text.encode())
    user_id = call("/api/accounts/profile")["id"]
    common = lambda kind: {
        "name": seal(f"Protected {kind}"), "reprompt": 1, "encryptedFor": user_id,
        "notes": seal(f"{kind} notes"),
        "fields": [{"type": 0, "name": seal("PIN"), "value": seal(f"{kind} pin")}],
    }
    items = {
        "card": {"type": 3, "card": {
            "cardholderName": seal("Alex Martin"), "brand": seal("Visa"),
            "number": seal("4111111111111111"), "expMonth": seal("09"),
            "expYear": seal("2029"), "code": seal("123")}},
        "identity": {"type": 4, "identity": {
            "title": seal("Mx"), "firstName": seal("Alex"), "lastName": seal("Martin"),
            "address1": seal("1 rue de la Paix"), "phone": seal("+33 1 23 45 67 89"),
            "email": seal("alex@example.com"), "ssn": seal("1 23 45"),
            "passportNumber": seal("19AB12345")}},
        "note": {"type": 2, "secureNote": {"type": 0}},
        "ssh key": {"type": 5, "sshKey": {
            "privateKey": seal(SSH_PRIVATE_KEY), "publicKey": seal("ssh-ed25519 AAAA"),
            "keyFingerprint": seal(SSH_FINGERPRINT)}},
    }
    return {kind: call("/api/ciphers", {**common(kind), **item})["id"]
            for kind, item in items.items()}


def organizations(rbw, quiet, shared_id):
    """An entry shared through an organization: read, edited, deleted."""
    shared = next(i for i in rbw.json("item", "list", env=quiet) if i["id"] == shared_id)
    check("list has the organization's entry",
          shared["organizationId"] and shared["name"] == "Family router"
          and shared["edit"] is True, str(shared))
    full = rbw.json("item", "get", shared_id, env=quiet)
    check("get decrypts it with the organization's key",
          full["login"]["password"] == "router-password")
    full["login"]["password"] = "new-router-password"
    rbw.run("item", "edit", shared_id, env=quiet, stdin=json.dumps(full))
    check("edit changes it", rbw.run("item", "get", shared_id, "--field", "password",
                                     env=quiet).stdout == "new-router-password\n")
    marked = rbw.json("item", "favorite", shared_id, "true", env=quiet)
    check("item favorite marks it", marked["favorite"] is True
          and marked["organizationId"] == shared["organizationId"], str(marked))
    error = rbw.error("item", "create", stdin=json.dumps({**full, "id": None}))
    check("create refuses an organization", error["code"] == "unsupported", str(error))
    rbw.run("item", "delete", shared_id, env=quiet)
    check("delete moves it to the trash",
          all(i["id"] != shared_id for i in rbw.json("item", "list", env=quiet)))


def agent(rbw, action):
    """One request to the profile's agent, as any program of the user can
    send it."""
    import socket

    request = {"tty": None, "action": action, "environment": {
        "tty": None, "env_vars": [[b64(b"RBW_NONINTERACTIVE"), b64(b"1")]]}}
    with socket.socket(socket.AF_UNIX) as sock:
        sock.connect(os.path.join(rbw.env["XDG_RUNTIME_DIR"], "rbw-scripting-check", "socket"))
        sock.sendall(json.dumps(request).encode() + b"\n")
        return json.loads(sock.makefile().readline())


def local_vault(rbw):
    """The path and the contents of the profile's local copy of the vault."""
    folder = os.path.join(rbw.env["HOME"], ".cache", "rbw-scripting-check")
    [name] = [name for name in os.listdir(folder) if name.endswith(".json")]
    path = os.path.join(folder, name)
    with open(path) as file:
        return path, json.load(file)


def save_local_vault(path, db):
    with open(path, "w") as file:
        json.dump(db, file)


def reprompt_attacks(rbw, quiet, password, protected_id, email):
    """What another program of the same user can try, with the agent's
    socket and the local copy of the vault, to read an entry that asks for
    the master password again."""
    path, db = local_vault(rbw)
    bank = next(entry for entry in db["entries"] if entry["id"] == protected_id)
    value = {"cipherstring": bank["data"]["Login"]["password"],
             "entry_key": bank["key"], "org_id": bank["org_id"]}
    answer = agent(rbw, {"type": "Decrypt", **value})
    check("the agent refuses the protected value",
          answer.get("code") == {"code": "reprompt_required"}, str(answer))
    stripped = value["cipherstring"].rsplit("|", 1)[0]
    answer = agent(rbw, {"type": "Decrypt", **value, "cipherstring": stripped})
    check("and the value without its MAC",
          answer["type"] == "Error" and "bank-password" not in json.dumps(answer), str(answer))

    bank["master_password_reprompt"] = 0
    save_local_vault(path, db)
    rbw.stop()
    rbw.run("unlock", "--password-stdin", stdin=password, env=quiet)
    check("an agent started on an edited local copy keeps the entry closed",
          rbw.error("item", "get", protected_id)["code"] == "reprompt_required")
    synced = rbw.json("status", "--json")["lastSync"]
    rbw.stop()
    time.sleep(1)
    rbw.run("unlock", "--password-stdin", stdin=password, env=quiet)
    check("an agent started on the local copy it vouched for needs no sync",
          rbw.error("item", "get", protected_id)["code"] == "reprompt_required"
          and rbw.json("status", "--json")["lastSync"] == synced)
    rbw.run("lock")
    time.sleep(1)
    rbw.run("sync", env=quiet)
    synced = rbw.json("status", "--json")["lastSync"]
    rbw.stop()
    rbw.run("unlock", "--password-stdin", stdin=password, env=quiet)
    check("and after a sync while it was locked",
          rbw.error("item", "get", protected_id)["code"] == "reprompt_required"
          and rbw.json("status", "--json")["lastSync"] == synced)

    # keys that open with another password, in place of the account's
    path, db = local_vault(rbw)
    original = dict(db)
    fake_key = secrets.token_bytes(64)
    _, private_der = rsa_keys()
    db.update({
        "kdf": 0, "iterations": 600_000, "memory": None, "parallelism": None,
        "protected_key": encrypt(*stretched_key(email, "not the password"), fake_key),
        "protected_private_key": encrypt(fake_key[:32], fake_key[32:], private_der),
        "protected_org_keys": {},
    })
    save_local_vault(path, db)
    error = rbw.error("item", "unlock", protected_id, "--password-stdin",
                      stdin="not the password")
    save_local_vault(path, original)
    check("item unlock wants the password of the unlocked vault",
          error["code"] == "incorrect_password", str(error))


def reprompt_kinds(rbw, quiet, kinds):
    """Cards, identities, notes and SSH keys that ask for the master password
    again."""
    listed = {item["id"]: item for item in rbw.json("item", "list", "--secrets", env=quiet)}
    shown = {"card": ("card", {"brand"}),
             "identity": ("identity", {"title", "firstName", "middleName", "lastName"}),
             "note": ("secureNote", {"type"}),
             "ssh key": ("sshKey", {"publicKey", "keyFingerprint"})}
    for kind, item_id in kinds.items():
        check(f"get needs the {kind} unlocked",
              rbw.error("item", "get", item_id)["code"] == "reprompt_required")
        item = listed[item_id]
        key, keys = shown[kind]
        check(f"list --secrets shows only the {kind}'s name and what list shows",
              "notes" not in item and "fields" not in item
              and set(item[key]) <= keys, str(item))
    check("a note's notes need it unlocked",
          rbw.error("item", "get", kinds["note"], "--field", "notes")["code"]
          == "reprompt_required")
    error = rbw.error("item", "edit", kinds["card"], stdin=json.dumps(listed[kinds["card"]]))
    check("editing a card needs it unlocked", error["code"] == "reprompt_required", str(error))
    found = rbw.run("search", "note notes")
    check("search doesn't look into closed notes, nor ask for the password",
          found.returncode == 0 and found.stdout == "", found.stderr)


def reprompt(rbw, quiet, password, protected_id):
    """An entry that asks for the master password again."""
    listed = next(i for i in rbw.json("item", "list", env=quiet) if i["id"] == protected_id)
    check("list says the entry asks for the password again", listed["reprompt"] == 1)
    error = rbw.error("item", "get", protected_id)
    check("get needs the entry unlocked", error["code"] == "reprompt_required", str(error))
    in_list = next(i for i in rbw.json("item", "list", "--secrets", env=quiet)
                   if i["id"] == protected_id)
    check("list --secrets lists it without its secrets",
          "password" not in in_list["login"] and in_list["login"]["username"] == "me",
          str(in_list))
    check("code needs it too",
          rbw.error("item", "code", protected_id)["code"] == "reprompt_required")
    check("its username is no secret",
          rbw.run("item", "get", protected_id, "--field", "username", env=quiet).stdout == "me\n")
    error = rbw.error("item", "unlock", protected_id, "--password-stdin", stdin="wrong")
    check("unlock refuses a wrong password", error["code"] == "incorrect_password", str(error))
    rbw.fails("item", "edit", protected_id, env=quiet, stdin=json.dumps(in_list),
              needle="asks for the master password again")
    check("edit needs it unlocked", True)
    rbw.run("item", "unlock", protected_id, "--password-stdin", stdin=password, env=quiet)
    full = rbw.json("item", "get", protected_id, env=quiet)
    check("unlock opens it", full["login"]["password"] == "bank-password", str(full["login"]))
    check("code works while it is open", len(rbw.json("item", "code", protected_id, env=quiet)["code"]) == 6)
    full["notes"] = "edited"
    rbw.run("item", "edit", protected_id, env=quiet, stdin=json.dumps(full))
    again = rbw.json("item", "get", protected_id, env=quiet)
    check("edit works while it is open, without a new history entry",
