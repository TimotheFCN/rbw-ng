def totp(secret_b32, at=None):
    """An RFC 6238 code (SHA-1, 6 digits, 30 s)."""
    import hashlib
    import hmac as std_hmac
    import struct

    key = base64.b32decode(secret_b32.upper() + "=" * (-len(secret_b32) % 8))
    counter = int((time.time() if at is None else at) // 30)
    digest = std_hmac.new(key, struct.pack(">Q", counter), hashlib.sha1).digest()
    offset = digest[-1] & 0x0F
    value = struct.unpack(">I", digest[offset:offset + 4])[0] & 0x7FFFFFFF
    return f"{value % 1_000_000:06d}"


def api(server, email, password):
    """Logs in to the server's API; returns a function that calls it, and
    the master password hash."""
    import urllib.parse
    import uuid

    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC

    master_key = PBKDF2HMAC(
        hashes.SHA256(), 32, email.lower().encode(), 600_000
    ).derive(password.encode())
    master_hash = base64.b64encode(
        PBKDF2HMAC(hashes.SHA256(), 32, password.encode(), 1).derive(master_key)
    ).decode()
    form = urllib.parse.urlencode({
        "grant_type": "password", "username": email, "password": master_hash,
        "scope": "api offline_access", "client_id": "cli", "deviceType": "8",
        "deviceIdentifier": str(uuid.uuid4()), "deviceName": "embedded-host-sim",
    }).encode()
    request = urllib.request.Request(server.rstrip("/") + "/identity/connect/token", data=form)
    with urllib.request.urlopen(request) as response:
        access_token = json.loads(response.read())["access_token"]

    def call(path, body=None):
        request = urllib.request.Request(
            server.rstrip("/") + path,
            data=None if body is None else json.dumps(body).encode(),
            headers={"Content-Type": "application/json",
                     "Authorization": f"Bearer {access_token}"})
        with urllib.request.urlopen(request) as response:
            return json.loads(response.read())

    return call, master_hash


def api_key(server, email, password):
    """The account's personal API key: its client id and secret."""
    call, master_hash = api(server, email, password)
    key = call("/api/accounts/api-key", {"masterPasswordHash": master_hash})
    return "user." + call("/api/accounts/profile")["id"], key["apiKey"]


def enable_authenticator(server, email, password):
    """Turns on authenticator-app two-step login; returns its secret."""
    post, master_hash = api(server, email, password)
    answer = post("/api/two-factor/get-authenticator",
                  {"masterPasswordHash": master_hash})
    # newer servers nest the key and add a token proving the password check
    nested = answer.get("authenticator") or answer
    secret = nested.get("key") or nested.get("Key")
    if not secret:
        raise RuntimeError(f"no authenticator key in {sorted(nested)}")
    body = {"key": secret, "token": totp(secret), "masterPasswordHash": master_hash}
    if answer.get("userVerificationToken"):
        body["userVerificationToken"] = answer["userVerificationToken"]
    post("/api/two-factor/authenticator", body)
    return secret



class Rbw:
    """rbw with a private HOME, as a program would run it."""

    def __init__(self, home, server, email):
        self.env = {
            "PATH": os.path.abspath(BIN) + ":/usr/bin:/bin",
            "HOME": home,
            "XDG_RUNTIME_DIR": os.path.join(home, "run"),
            "TMPDIR": os.path.join(home, "tmp"),
            "LANG": "en_US.UTF-8",
            "RBW_PROFILE": "scripting-check",
        }
        for folder in ("run", "tmp"):
            os.makedirs(os.path.join(home, folder), mode=0o700, exist_ok=True)
        self.run("config", "set", "base_url", server)
        self.run("config", "set", "email", email)
        # a pinentry that fails, so any prompt shows up as an error
        self.run("config", "set", "pinentry", "/bin/false")

    def run(self, *args, stdin=None, env=None, check=True):
        result = subprocess.run(
            [os.path.join(BIN, "rbw"), *args],
            input=stdin,
            capture_output=True,
            text=True,
            env={**self.env, **(env or {})},
            timeout=120,
        )
        if check and result.returncode != 0:
            raise AssertionError(
                f"rbw {' '.join(args)} failed: {result.stderr.strip()}"
            )
        return result

    def json(self, *args, **kwargs):
        return json.loads(self.run(*args, **kwargs).stdout)

    def fails(self, *args, needle, **kwargs):
        result = self.run(*args, check=False, **kwargs)
        if result.returncode == 0:
            raise AssertionError(f"rbw {' '.join(args)} succeeded")
        if needle not in result.stderr:
            raise AssertionError(
                f"rbw {' '.join(args)}: expected {needle!r} in {result.stderr.strip()!r}"
            )
        return result

    def error(self, *args, **kwargs):
        """The JSON error of a command that fails, with RBW_ERROR_FORMAT=json."""
        env = {"RBW_NONINTERACTIVE": "1", "RBW_ERROR_FORMAT": "json",
               **kwargs.pop("env", {})}
        result = self.run(*args, check=False, env=env, **kwargs)
        if result.returncode == 0:
            raise AssertionError(f"rbw {' '.join(args)} succeeded")
        return json.loads(result.stderr.strip().splitlines()[-1])

    def stop(self):
        self.run("stop-agent", check=False)


PASSED = 0


def check(name, condition, detail=""):
    global PASSED
    if not condition:
        raise AssertionError(f"{name} {detail}")
    PASSED += 1
    print(f"ok  {name}")


