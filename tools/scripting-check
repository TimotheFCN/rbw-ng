def b64(data):
    return base64.b64encode(data).decode()


def encrypt(enc_key, mac_key, plaintext):
    """A type 2 cipherstring: AES-256-CBC with HMAC-SHA256."""
    from cryptography.hazmat.primitives import hashes, hmac, padding
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

    iv = secrets.token_bytes(16)
    padder = padding.PKCS7(128).padder()
    padded = padder.update(plaintext) + padder.finalize()
    encryptor = Cipher(algorithms.AES(enc_key), modes.CBC(iv)).encryptor()
    ciphertext = encryptor.update(padded) + encryptor.finalize()
    mac = hmac.HMAC(mac_key, hashes.SHA256())
    mac.update(iv + ciphertext)
    return f"2.{b64(iv)}|{b64(ciphertext)}|{b64(mac.finalize())}"


def decrypt(enc_key, mac_key, cipherstring):
    """Opens a type 2 cipherstring, checking its MAC."""
    from cryptography.hazmat.primitives import hashes, hmac, padding
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

    iv, ciphertext, mac = (base64.b64decode(part) for part in cipherstring[2:].split("|"))
    check_mac = hmac.HMAC(mac_key, hashes.SHA256())
    check_mac.update(iv + ciphertext)
    check_mac.verify(mac)
    decryptor = Cipher(algorithms.AES(enc_key), modes.CBC(iv)).decryptor()
    padded = decryptor.update(ciphertext) + decryptor.finalize()
    unpadder = padding.PKCS7(128).unpadder()
    return unpadder.update(padded) + unpadder.finalize()


def stretched_key(email, password, iterations=600_000):
    """The key that the master password derives, to encrypt the vault key."""
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.kdf.hkdf import HKDFExpand
    from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC

    master_key = PBKDF2HMAC(
        hashes.SHA256(), 32, email.lower().encode(), iterations
    ).derive(password.encode())
    return (HKDFExpand(hashes.SHA256(), 32, b"enc").derive(master_key),
            HKDFExpand(hashes.SHA256(), 32, b"mac").derive(master_key))


def rsa_keys():
    """A new RSA key pair, as DER: the public key and the private key."""
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric import rsa

    private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    public_der = private_key.public_key().public_bytes(
        serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo
    )
    private_der = private_key.private_bytes(
        serialization.Encoding.DER,
        serialization.PrivateFormat.PKCS8,
        serialization.NoEncryption(),
    )
    return public_der, private_der


def register(server, email, password):
    """Creates a Bitwarden account the way the official clients do; returns
    its public key."""
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.kdf.hkdf import HKDFExpand
    from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC

    iterations = 600_000
    master_key = PBKDF2HMAC(
        hashes.SHA256(), 32, email.lower().encode(), iterations
    ).derive(password.encode())
    master_hash = PBKDF2HMAC(hashes.SHA256(), 32, password.encode(), 1).derive(
        master_key
    )
    stretched_enc = HKDFExpand(hashes.SHA256(), 32, b"enc").derive(master_key)
    stretched_mac = HKDFExpand(hashes.SHA256(), 32, b"mac").derive(master_key)

    user_key = secrets.token_bytes(64)
    public_der, private_der = rsa_keys()

    def post(path, body):
        request = urllib.request.Request(
            server.rstrip("/") + path,
            data=json.dumps(body).encode(),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(request) as response:
            return response.read().decode()

    # without email verification, the server answers with the token itself
    token = post("/identity/accounts/register/send-verification-email",
                 {"email": email, "name": "rbw-ng demo",
                  "receiveMarketingEmails": False}).strip().strip('"')
    post("/identity/accounts/register/finish", {
        "email": email,
        "emailVerificationToken": token,
        "masterPasswordHash": base64.b64encode(master_hash).decode(),
        "masterPasswordHint": None,
        "userSymmetricKey": encrypt(stretched_enc, stretched_mac, user_key),
        "userAsymmetricKeys": {
            "publicKey": base64.b64encode(public_der).decode(),
            "encryptedPrivateKey": encrypt(user_key[:32], user_key[32:], private_der),
        },
        "kdf": 0,
        "kdfIterations": iterations,
    })
    return public_der


